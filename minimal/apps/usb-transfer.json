{
  "schema": 1,
  "id": "usb_sd_transfer",
  "version": "0.1.2",
  "file_name": "usb_sd_transfer.elf",
  "usb_role": "device",
  "grants": [
    {
      "capability": "display.output",
      "api": 1,
      "instance_id": 3
    },
    {
      "capability": "input.touch.raw",
      "api": 1,
      "instance_id": 4
    },
    {
      "capability": "input.navigation",
      "api": 1,
      "instance_id": 6
    },
    {
      "capability": "usb.device.msc",
      "api": 1,
      "instance_id": 0
    }
  ],
  "launch": {
    "springboard_catalog": "USB Transfer",
    "quick_actions_build_flag": "--quick-usb-transfer",
    "quick_actions_define": "PORTABLE_QUICK_USB_TRANSFER",
    "required_springboard_version": "1.7.17"
  },
  "return_app": "springboard.elf",
  "home_app": "default.elf",
  "poll_interval_ms": 2,
  "sleep": false,
  "navigation_requires_release": true,
  "configured_stop_requires_cable_confirmation": true,
  "log_files": [
    "x4-boot.log",
    "x4-boot.previous.log"
  ],
  "sd_preparation": {
    "extension_tag": "0x554d5031",
    "extension_version": 1,
    "explicit_step": true,
    "settled_screen_required": true,
    "max_steps_per_input_poll": 1,
    "wait_poll_prepares": false
  }
}
